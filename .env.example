# Copia este archivo a ".env" y completa con los valores de tu proyecto Firebase
# (Firebase Console > Configuración del proyecto > Tus apps > SDK setup and configuration)
#
# IMPORTANTE: el archivo ".env" real NUNCA debe subirse a Git (ya está en .gitignore).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
