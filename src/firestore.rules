rules_version = '2';

// =====================================================================
// FIRESTORE SECURITY RULES — Nexus OS / Task Manager TL
// =====================================================================
// CÓMO DESPLEGAR ESTE ARCHIVO (no se aplica solo con tenerlo en el repo):
//   1. Instala Firebase CLI:  npm install -g firebase-tools
//   2. firebase login
//   3. firebase use <tu-project-id>      (o crea firebase.json con firebase init)
//   4. firebase deploy --only firestore:rules
//
// Antes de desplegar a producción, pruébalas en el "Rules Playground"
// de la consola de Firebase (Firestore Database > Reglas > Playground).
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Lee el rol del usuario que hace la petición desde su propio doc en /users.
    // OJO: esto hace una lectura extra (get) en cada evaluación de regla que la usa.
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isTeamLeaderOrAdmin() {
      return isSignedIn() && myRole() in ['team_leader', 'admin'];
    }

    function isAdmin() {
      return isSignedIn() && myRole() == 'admin';
    }

    // --- /users/{uid} ---------------------------------------------------
    match /users/{uid} {
      allow read: if isOwner(uid) || isTeamLeaderOrAdmin();

      // Un usuario puede crear SU PROPIO doc de perfil, pero solo con rol 'agent'.
      // Evita que alguien se auto-asigne 'admin' o 'team_leader' al registrarse.
      allow create: if isOwner(uid)
                    && request.resource.data.role == 'agent';

      // Un usuario puede actualizar su propio doc, PERO NUNCA su propio campo "role".
      // Cambiar roles solo lo puede hacer un team_leader/admin (p.ej. desde TLUsersTab).
      // 🔒 Esto es la corrección directa del bug de escalación de privilegios.
      allow update: if (isOwner(uid) && request.resource.data.role == resource.data.role)
                    || isTeamLeaderOrAdmin();

      allow delete: if isAdmin();

      // Subcolecciones privadas del usuario: wallet, config, inventario, etc.
      // Ej: users/{uid}/data/wallet, users/{uid}/config/theme
      match /{subcollection}/{docId} {
        allow read: if isOwner(uid) || isTeamLeaderOrAdmin();
        allow write: if isOwner(uid);
      }
    }

    // --- /daily_reports/{reportId} --------------------------------------
    // Se asume que cada reporte guarda el uid del autor en el campo "uid".
    match /daily_reports/{reportId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isTeamLeaderOrAdmin());
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.uid == request.auth.uid || isTeamLeaderOrAdmin());
      allow delete: if isTeamLeaderOrAdmin();
    }

    // --- /reports/{reportId} (alias legado usado en reportService.js) ---
    match /reports/{reportId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isTeamLeaderOrAdmin());
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.uid == request.auth.uid || isTeamLeaderOrAdmin());
      allow delete: if isTeamLeaderOrAdmin();
    }

    // --- /monday_ideas/{ideaId} ------------------------------------------
    match /monday_ideas/{ideaId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isTeamLeaderOrAdmin());
    }

    // --- /news_ticker/{newsId} -------------------------------------------
    // Cualquier usuario autenticado puede leer las noticias, pero solo
    // team leaders / admins pueden publicarlas o editarlas.
    match /news_ticker/{newsId} {
      allow read: if isSignedIn();
      allow write: if isTeamLeaderOrAdmin();
    }

    // --- /training_modules/{moduleId} ------------------------------------
    match /training_modules/{moduleId} {
      allow read: if isSignedIn();
      allow write: if isTeamLeaderOrAdmin();
    }

    // --- /schedule_requests/{id} y /scheduleRequests/{id} ----------------
    match /schedule_requests/{id} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isTeamLeaderOrAdmin());
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isTeamLeaderOrAdmin();
    }
    match /scheduleRequests/{id} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isTeamLeaderOrAdmin());
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isTeamLeaderOrAdmin();
    }

    // --- /weekly_plans/{id} y /weekly_schedules/{id} ----------------------
    // Planificación del Team Leader: solo lectura para agentes, escritura para TL/admin.
    match /weekly_plans/{id} {
      allow read: if isSignedIn();
      allow write: if isTeamLeaderOrAdmin();
    }
    match /weekly_schedules/{id} {
      allow read: if isSignedIn();
      allow write: if isTeamLeaderOrAdmin();
    }

    // --- /recurring_announcements/{id} -------------------------------------
    // Anuncios que reaparecen solos (diarios o semanales en un día fijo),
    // ej: "mandar disponibilidad" todos los sábados. Mismo esquema de
    // permisos que daily_announcements.
    match /recurring_announcements/{id} {
      allow read: if isSignedIn();
      allow write: if isTeamLeaderOrAdmin();
    }

    // --- /daily_announcements/{dateId} ------------------------------------
    // "Tablón de Anuncios del Día". Cualquier usuario autenticado puede leerlo
    // (necesita ver los avisos de hoy); solo team_leader/admin pueden armarlo.
    match /daily_announcements/{dateId} {
      allow read: if isSignedIn();
      allow write: if isTeamLeaderOrAdmin();
    }

    // --- /quick_links/{id} -------------------------------------------------
    // Enlaces rápidos a páginas externas, unificados por el TL para el equipo.
    match /quick_links/{id} {
      allow read: if isSignedIn();
      allow write: if isTeamLeaderOrAdmin();
    }

    // --- /app_analytics/{id} ----------------------------------------------
    // Analítica agregada: solo TL/admin deberían leerla; cualquier usuario
    // autenticado puede generar eventos (logEvent), pero no editarlos/borrarlos.
    match /app_analytics/{id} {
      allow read: if isTeamLeaderOrAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Cualquier otra colección no listada explícitamente: denegar por defecto.
    // (Comportamiento por defecto de Firestore si no hay match, pero lo dejamos
    // explícito para que quede documentado el criterio "deny by default".)
  }
}
